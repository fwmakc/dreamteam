{
  "default": "openai",
  "providers":{
    "mock":{
      "adapter":"mock"
    },
    "openai": {
      "adapter": "openai-compatible",
      "baseUrl": "https://api.z.ai/api/coding/paas/v4",
      "apiKeyEnv": "OPENAI_API_KEY",
      "model": "glm-5-turbo"
    },
    "glm-vision": {
      "adapter": "openai-compatible",
      "baseUrl": "https://api.z.ai/api/paas/v4",
      "apiKeyEnv": "OPENAI_API_KEY",
      "model": "glm-4.6v",
      "vision": true
    },
    "qwen2-vl-2b": {
      "adapter": "openai-compatible",
      "baseUrl": "http://localhost:8000/v1",
      "model": "Qwen2-VL-2B-Instruct",
      "vision": true
    },
    "qwen3-vl-4b": {
      "adapter": "openai-compatible",
      "baseUrl": "http://localhost:8003/v1",
      "model": "Qwen3-VL-4B-Instruct",
      "vision": true
    },
    "qwen2.5-vl-7b": {
      "adapter": "openai-compatible",
      "baseUrl": "http://localhost:8001/v1",
      "model": "Qwen2.5-VL-7B-Instruct",
      "vision": true
    },
    "qwen3-vl-8b": {
      "adapter": "openai-compatible",
      "baseUrl": "http://localhost:8002/v1",
      "model": "Qwen3-VL-8B-Instruct",
      "vision": true
    },
    "sd-turbo": {
      "adapter": "openai-images",
      "baseUrl": "http://localhost:8100/v1",
      "model": "sd-turbo"
    },
    "bk-sdm": {
      "adapter": "openai-images",
      "baseUrl": "http://localhost:8105/v1",
      "model": "bk-sdm"
    },
    "flux-schnell": {
      "adapter": "openai-images",
      "baseUrl": "http://localhost:8101/v1",
      "model": "flux-schnell"
    },
    "flux-dev": {
      "adapter": "openai-images",
      "baseUrl": "http://localhost:8102/v1",
      "model": "flux-dev"
    },
    "photomaker": {
      "adapter": "openai-images",
      "baseUrl": "http://localhost:8103/v1",
      "model": "photomaker"
    },
    "qwen-image-edit": {
      "adapter": "openai-images",
      "baseUrl": "http://localhost:8104/v1",
      "model": "qwen-image-edit"
    },
    "mock-images": {
      "adapter": "mock-images"
    },
    "claude": {
      "adapter": "anthropic",
      "apiKeyEnv": "ANTHROPIC_API_KEY",
      "model": "claude-sonnet-4-5"
    },
    "gigachat": {
      "adapter": "gigachat",
      "keyEnv": "GIGA_API_KEY",
      "scope": "GIGACHAT_API_PERS",
      "caCertPath": "certs/russian_trusted_root_ca.pem",
      "model": "GigaChat"
    }
  }
}
