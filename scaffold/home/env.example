# Пример ~/.dreamteam/.env: мастер копирует его при первом запуске
# и дописывает настоящий TOKEN. Настройки — вещь машины: в архив
# /home export не входят. Ключи моделей живут в карточках models/<id>.json.

# Веб-сервер (dreamteam serve): порт и адрес
# PORT=8080
# HOST=127.0.0.1
# (HOST=0.0.0.0 открывает сервер в сеть — баннер напечатает адреса машины)

# HTTPS (dreamteam serve): файлы сертификата и ключа — задаются парой;
# годится самоподписный, браузер предупредит о нём один раз
# SSL_CERT=/etc/ssl/certs/dreamteam.pem
# SSL_KEY=/etc/ssl/private/dreamteam-key.pem

# Токен доступа к API: без него сервер открыт только на 127.0.0.1;
# перегенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# TOKEN=
