# Ключи провайдеров: имена должны совпадать с apiKeyEnv/keyEnv в providers.json
# DREAMTEAM_API_KEY=sk-…
# OPENAI_API_KEY=sk-…
# ANTHROPIC_API_KEY=sk-…
# GIGA_API_KEY=…

# Веб-сервер (dreamteam serve): порт и адрес
# PORT=8080
# HOST=127.0.0.1

# Токен доступа к API: мастер создаёт свой (строка TOKEN ниже);
# перегенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# TOKEN=
