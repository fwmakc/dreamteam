# Пример ~/.dreamteam/.env: мастер копирует его при первом запуске
# и дописывает настоящий TOKEN. Настройки — вещь машины: в архив
# /home export не входят. Ключи моделей живут в providers.json.

# Веб-сервер (dreamteam serve): порт и адрес
# PORT=8080
# HOST=127.0.0.1

# Токен доступа к API: без него сервер открыт только на 127.0.0.1;
# перегенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# TOKEN=
