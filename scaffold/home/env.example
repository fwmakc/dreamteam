# Ключи моделей — НЕ здесь: поле "apiKey" в карточке провайдера
# (~/.dreamteam/providers.json). Этот файл — только переменные окружения
# для команд агентов и самого приложения.

# Веб-сервер (dreamteam serve): порт и адрес
# PORT=8080
# HOST=127.0.0.1

# Токен доступа к API: мастер создаёт свой (строка TOKEN ниже);
# перегенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# TOKEN=
