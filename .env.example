# Ключи приложения живут в ~/.dreamteam/.env — впишите нужные строки туда
# (этот файл — просто список-подсказка). Имена переменных можно менять —
# они задаются полем apiKeyEnv/keyEnv в ~/.dreamteam/providers.json.

# Open AI compatible (например, модели GLM платформы Z.ai): ключ из личного кабинета
OPENAI_API_KEY=

# Anthropic (Claude): ключ из console.anthropic.com
ANTHROPIC_API_KEY=

# Сбер GigaChat: API-ключ из кабинета developers.sber.ru/gigachat
# (ключ из кабинета — это уже готовая Basic-строка, вставляется целиком)
GIGA_API_KEY=
# Либо пара client_id/secret — тогда в ~/.dreamteam/providers.json для провайдера
# gigachat укажите "clientIdEnv": "GIGA_CLIENT_ID", "clientSecretEnv": "GIGA_CLIENT_SECRET"
# GIGA_CLIENT_ID=
# GIGA_CLIENT_SECRET=
